# See ENV.md for full documentation of every variable.

# --- Model (required) ---
# Format: provider:model_name  (providers: anthropic | openai | google_genai)
MODEL=anthropic:claude-sonnet-5

# API key for whichever provider MODEL uses (only one is required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Tools ---
# Web search (app.tavily.com — free tier available). Leave empty to disable web search.
TAVILY_API_KEY=

# GitHub fine-grained PAT, scoped ONLY to repos the agent may touch.
# Leave empty to disable the GitHub MCP integration.
GITHUB_PAT=

# --- Optional ---
# CHECKPOINT_DB=checkpoints.sqlite
# MCP_SERVERS={}
# GITHUB_TOOL_ALLOWLIST=
# RECURSION_LIMIT=100
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
