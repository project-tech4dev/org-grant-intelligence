# Copy to .env and fill in. .env is gitignored.

# Groq does the entity/fact extraction and writes the natural-language answer.
GROQ_API_KEY=
# Used for extraction (structured JSON) and for the prose answer.
# Note: llama-3.3-70b-versatile has been retired from Groq — check
# https://console.groq.com/docs/models if this 404s.
GROQ_MODEL=openai/gpt-oss-120b

# FalkorDB, as started by docker-compose.yml.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_DATABASE=graphiti

# Must match the embedder in add_episodes.py.
# 384 = sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
