# Copy to .env and fill in. .env is gitignored.

# Claude does the entity/fact extraction and writes the natural-language answer.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Used for extraction (structured tool output) and for the prose answer.
ANTHROPIC_MODEL=claude-opus-5
# Optional: low|medium|high|xhigh|max. Unset means the API default (high).
# Extraction is several calls per episode, so this is the cheapest lever on a
# large ingest -- try `low` first and check the extracted facts.
ANTHROPIC_EFFORT=

# FalkorDB, as started by docker-compose.yml.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_DATABASE=graphiti

# Must match the embedder in add_episodes.py.
# 384 = sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
